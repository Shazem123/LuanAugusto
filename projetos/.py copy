import json
cidades = []

def salvar_dados():
    try:
        with open('cidades.json', 'w', encoding='utf-8') as f:
            json.dump(cidades, f, ensure_ascii=False, indent=4)
    except Exception as e:
        print(f"Erro ao salvar: {e}")

def carregar_dados():
    global cidades
    try:
        with open('cidades.json', 'r', encoding='utf-8') as f:
            cidades = json.load(f)
            print("Memória encontrada!")
    except (FileNotFoundError, json.JSONDecodeError):
        cidades = []
        salvar_dados()

def listagem():
    if not cidades:
        print('Lista de cidades vazias! Adicione uma cidade para continuar.')
        return False

    print('Lista detalhada:')
    for i, c in enumerate(cidades, start = 1):
        print(f"{i}. {c['nome']}, {c['país']}")
    return True

carregar_dados()
print('Bem vindo ao programa de cidades e países!')
while True:
    print('Ver lista: 1 | Adicionar cidade: 2| Remover cidade: 3| Filtrar por país: 4| Sair do programa: (q)')
    escolha = input('Escolha: ').lower()

    if escolha == '1':
        listagem()

    elif escolha == '2':
        nome = input('Digite o nome da cidade: ')
        país = input('Digite o país da cidade: ')

        cidades.append({'nome': nome, 'país': país})
        salvar_dados()
        listagem()
        print(f"Cidade {nome} do país {país} adicionada e salva na memória!")

    elif escolha == '3':
        if listagem():
            try:
                nº = int(input('Escolha a cidade (nº): '))
                cidade_removida = cidades.pop(nº - 1) 
                salvar_dados()
                print(f"Cidade {cidade_removida['nome']} de número nº{nº} removida com sucesso!")
            except (ValueError, IndexError):
                print('Escolha um número válido!')

    elif escolha == '4':
        busca = input('Qual país deseja filtrar? ').strip().lower()
        
        print(f"Cidades em: {busca.title()}")
        encontrou = False
        for i, c in enumerate(cidades, start = 1):
            if busca == c['país'].lower():
                print(f"{i}, {c['nome']}")
                encontrou = True

        if not encontrou:
            print('Nenhuma cidade encontrada nesse país.')

    elif escolha == 'q':
        print('Encerrando programa.')
        break